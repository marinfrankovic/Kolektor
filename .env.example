# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=kolektor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kolektor

KOLEKTOR_SECRET_KEY=generate-with-openssl-rand-hex-32

# Optional. Leave both blank to get the first-run screen in the browser, where you
# choose between "protect with a password" and "no login" (LAN only).
KOLEKTOR_INITIAL_USER_EMAIL=
KOLEKTOR_INITIAL_USER_PASSWORD=

# en or hr
KOLEKTOR_DEFAULT_LANGUAGE=en

KOLEKTOR_ENABLE_REMBG=false
KOLEKTOR_AUTOCROP=true
KOLEKTOR_AUTOENHANCE=false

KOLEKTOR_HTTP_PORT=8100

# Published image. Override to pin a version, or to run a locally built image.
KOLEKTOR_IMAGE=mfrankovic/kolektor:latest

# Where Postgres and uploaded photos live on the host.
KOLEKTOR_PGDATA=./data/postgres
KOLEKTOR_MEDIA_DIR=./data/media

# --- optional: custom domain behind a reverse proxy -------------------------
# Leave all three as-is for plain LAN use over http://<host>:8100.
KOLEKTOR_BEHIND_PROXY=false
KOLEKTOR_COOKIE_SECURE=false
KOLEKTOR_PUBLIC_BASE_URL=
