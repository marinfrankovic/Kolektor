# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=kolektor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kolektor

KOLEKTOR_SECRET_KEY=generate-with-openssl-rand-hex-32
KOLEKTOR_INITIAL_USER_EMAIL=you@example.com
KOLEKTOR_INITIAL_USER_PASSWORD=change-me

KOLEKTOR_ENABLE_OCR=true
KOLEKTOR_OCR_LANGUAGES=eng+hrv+deu
KOLEKTOR_ENABLE_REMBG=false
KOLEKTOR_AUTOCROP=true
KOLEKTOR_AUTOENHANCE=true

KOLEKTOR_HTTP_PORT=8100
